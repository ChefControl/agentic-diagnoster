# Copy to .env and fill in a key. .env is gitignored.

# One key or both. The agent uses OpenAI's gpt-6-luna when OPENAI_API_KEY is
# set, else Anthropic's claude-haiku-5-5. Phoenix uses the same keys for its
# judge and Playground.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which cluster the agent reads: live (the kind cluster, scenarios deployed)
# or recorded (a saved snapshot of the four scenarios, no cluster needed).
CLUSTER_MODE=live

# Optional; these are the defaults.
# MODEL=openai:gpt-6-luna            # provider:model, e.g. anthropic:claude-opus-5-5
# JUDGE_MODEL=anthropic:claude-sonnet-5   # or openai:gpt-6.1-sol when only OpenAI's key is set
# READER_KUBECONFIG=.kube/reader.kubeconfig
# REMEDIATOR_KUBECONFIG=.kube/remediator.kubeconfig
# AGENT_NAMESPACES=shop,payments,catalog,inventory
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_URL=http://localhost:6006
# REQUEST_LIMIT=10
# TOOL_CALLS_LIMIT=15
# TOKENS_LIMIT=300000                # input + output tokens of all a run's model calls
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],agent   # Host names the agent service answers to
# RUN_TIMEOUT_S=180
