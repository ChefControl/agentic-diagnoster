# Copy to .env and fill in the key for the model you use. .env is gitignored.

# provider:model. Examples: openrouter:openai/gpt-6-luna, anthropic:claude-haiku-5-5
MODEL=openrouter:openai/gpt-6-luna
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional; these are the defaults.
# READER_KUBECONFIG=.kube/reader.kubeconfig
# REMEDIATOR_KUBECONFIG=.kube/remediator.kubeconfig
# AGENT_NAMESPACES=shop,payments,catalog,inventory
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_URL=http://localhost:6006
# REQUEST_LIMIT=10
# TOOL_CALLS_LIMIT=15
# RUN_TIMEOUT_S=180
