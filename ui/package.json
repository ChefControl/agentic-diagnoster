{
  "name": "agentic-diagnoster-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch --include '../scenarios/**' src/server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scenarios": "tsx src/server/cli.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.36",
    "@assistant-ui/react-markdown": "^0.14.26",
    "@fastify/static": "^10.1.11",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@kubernetes/client-node": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "fastify": "^5.12.8",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-shimmer": "^0.4.14",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
